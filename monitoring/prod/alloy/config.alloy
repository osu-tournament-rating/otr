discovery.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

// Other services share the production host, and every Grafana user can read
// Loki, so only containers named otr-*, as docker-compose.yml names all of
// o!TR's, have their logs collected.
discovery.relabel "otr_containers" {
	targets = discovery.docker.docker.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/otr-.*"
		action        = "keep"
	}
}

discovery.relabel "docker_logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_id"]
		target_label  = "container_id"
	}

	rule {
		source_labels = ["__meta_docker_container_image"]
		target_label  = "image"
	}
}

loki.source.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.otr_containers.output
	forward_to       = [loki.write.default.receiver]
	relabel_rules    = discovery.relabel.docker_logs.rules
	refresh_interval = "5s"
}

loki.write "default" {
	endpoint {
		url = "http://otr-loki:3100/loki/api/v1/push"
	}
}

otelcol.receiver.otlp "otlp" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "otr-tempo:4317"

		tls {
			insecure = true
		}
	}
}
