          "expr": "max(up{job=\"web\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "Up while either web instance answers scrapes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
