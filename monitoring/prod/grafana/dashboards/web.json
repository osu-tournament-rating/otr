          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (procedure) (increase(web_orpc_procedure_calls_total{code=~\"5..\",code!=\"503\"}[$__range])) / sum by (procedure) (increase(web_orpc_procedure_calls_total[$__range]))",
          "legendFormat": "__auto",
