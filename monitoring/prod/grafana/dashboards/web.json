        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, procedure) (increase(web_orpc_procedure_duration_seconds_bucket[$__range]))) and on (procedure) sum by (procedure) (increase(web_orpc_procedure_duration_seconds_count[$__range])) >= 10",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, procedure) (increase(web_orpc_procedure_duration_seconds_bucket[$__range]))) and on (procedure) sum by (procedure) (increase(web_orpc_procedure_duration_seconds_count[$__range])) >= 10",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "E"
        }
