          },
          "expr": "count(max by (queue) (data_worker_jobs_loop_active{queue=~\"$queue\"}) == 0) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "Queues whose loop is stopped or paused. Most loops pause during the maintenance window.",
