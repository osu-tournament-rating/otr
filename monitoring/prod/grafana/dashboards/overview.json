                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "parked"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "failed"
              },
              {
                "id": "color",
                "value": {
