            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(data_worker_queue_messages_processed_total[$__rate_interval])) * 3600",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
