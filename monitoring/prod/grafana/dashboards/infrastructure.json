{
  "uid": "infrastructure",
  "title": "Infrastructure",
  "description": "",
  "tags": ["otr"],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "tags": ["otr"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "o!TR",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(process_start_time_seconds{job=\"web\", instance=~\"otr-web:.*\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Deploy",
        "textFormat": "web restarted"
      },
      {
        "name": "Rating runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(otr_script_last_run_timestamp_seconds{script=\"processor\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Processor run finished"
      },
      {
        "name": "Maintenance window",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.15)",
        "target": {
          "queryType": "timeRegions",
          "refId": "Anno",
          "timeRegion": {
            "fromDayOfWeek": 2,
            "from": "11:45",
            "toDayOfWeek": 2,
            "to": "12:15",
            "timezone": "utc"
          }
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Last archive",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - otr_script_last_run_timestamp_seconds{script=\"archive\",bucket=\"production\"}) and on () (otr_script_last_run_success{script=\"archive\",bucket=\"production\"} == 1) or on () (otr_script_last_run_success{script=\"archive\",bucket=\"production\"} - 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "Time since the last production archive finished. One runs every 6 hours.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 25200
              },
              {
                "color": "red",
                "value": 28800
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Failed",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
