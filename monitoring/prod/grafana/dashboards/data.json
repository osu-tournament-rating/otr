      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('week', created) AS time, count(*) AS \"Submitted\"\nFROM tournaments\nWHERE $__timeFilter(created)\nGROUP BY 1\nORDER BY 1",
