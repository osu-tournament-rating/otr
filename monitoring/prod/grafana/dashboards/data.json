    {
      "type": "bargauge",
      "title": "Tournaments by status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE verification_status WHEN 0 THEN 'None' WHEN 1 THEN 'Pre-rejected' WHEN 2 THEN 'Pre-verified' WHEN 3 THEN 'Rejected' WHEN 4 THEN 'Verified' END AS status, count(*) AS tournaments\nFROM tournaments\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
