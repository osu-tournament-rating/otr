          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE ruleset WHEN 0 THEN 'osu!' WHEN 1 THEN 'osu!taiko' WHEN 2 THEN 'osu!catch' WHEN 3 THEN 'osu!mania (other)' WHEN 4 THEN 'osu!mania 4K' WHEN 5 THEN 'osu!mania 7K' END AS ruleset, count(*) AS players\nFROM player_ratings\nGROUP BY ruleset\nORDER BY 2 DESC",
