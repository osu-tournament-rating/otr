    {
      "type": "table",
      "title": "Tournaments waiting for review",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT id AS \"ID\", name AS \"Name\", CASE verification_status WHEN 0 THEN 'None' WHEN 1 THEN 'Pre-rejected' WHEN 2 THEN 'Pre-verified' WHEN 3 THEN 'Rejected' WHEN 4 THEN 'Verified' END AS \"Status\",\n  created AS \"Submitted\", extract(epoch FROM now() - created) AS \"Waiting\"\nFROM tournaments\nWHERE verification_status IN (0, 1, 2)\nORDER BY created\nLIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ],
      "description": "Oldest first.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
