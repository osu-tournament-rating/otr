          "queryType": "timeRegions",
          "refId": "Anno",
          "timeRegion": {
            "fromDayOfWeek": 2,
            "from": "11:45",
            "toDayOfWeek": 2,
            "to": "12:15",
            "timezone": "utc"
          }
        }
      }
    ]
