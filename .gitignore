# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.vscode/

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/
**/e2e/.auth/

# next.js
.next/
out/

# production
build/

# rust
apps/processor/target/

# python
apps/scripts/.venv/
apps/scripts/.pytest_cache/
apps/scripts/.ruff_cache/
apps/replay/.venv/
apps/replay/.pytest_cache/
apps/replay/.ruff_cache/
apps/replay/otr-replay_*

# node-exporter's textfile directory (docker-compose.yml)
textfile-collector/

# misc
.DS_Store
*.pem
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.claude/agent-memory
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

# jetbrains
.idea/

# Other
remove-local-link.sh
setup-local-link.sh
**/dist/
monitoring/loki/data/
.playwright-mcp/
.mcp.json

# top-level images (playwright mcp)
*.png
# The rule above matches in every directory, so re-include the docs' images.
!apps/docs/**/*.png
