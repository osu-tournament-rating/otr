.git
.github
.vscode
.husky
.agents
# `**/` is required: a bare `node_modules` strips only the root folder, and the
# workspace copies under apps/* and packages/* hold bun symlinks that collide
# with the real directories `bun install` creates in the image.
**/node_modules
.bun
.bun_tmp
.tmp
.next
apps/web/.next
apps/web/.turbo
apps/web/out
bun.lockb
*.log
*.tsbuildinfo
.env
.env.*
.DS_Store
npm-debug.log
yarn-error.log
coverage

# Tests, reports, and files not needed in any image build context.
# NOTE: globs here are non-recursive — `*.md` strips only root-level docs,
# preserving nested assets like apps/web/public/icons/grades/README.md.
# Do NOT exclude scripts/ or apps/web/drizzle/ — the migrate service needs them.
apps/web/playwright-report
apps/web/test-results
apps/web/e2e
# Imports from apps/web/e2e, so `next build` would fail to type-check it.
apps/web/playwright.config.ts
apps/data-worker/tests
# The processor image builds with apps/processor as its own context.
apps/processor
# The docs image builds with apps/docs as its own context.
apps/docs
# The scripts run from a checkout on the host, not from an image.
apps/scripts
# The replay tool runs from a checkout on the user's machine, not from an image.
apps/replay
monitoring
docker-compose*.yml
Dockerfile
apps/**/Dockerfile
*.md
LICENSE
.prettierrc
