# === README ===
# Rename this file to .env and fill out the variables as needed.
# Docker & the applications rely on this file being named .env in the root of the repository.
# Local-first variables appear without a prefix; Docker-specific overrides use
# the DOCKER_ prefix and are consumed automatically by docker compose.
#
# For example, the DATABASE_URL var is used in local development (i.e. bun run dev)
# but not anywhere else. It exists because the syntax for the connection string is different
# when running outside of docker-compose. Having a docker-specific variant removes
# the need to modify vars between docker/non-docker runs locally.
#
# A blank value (KEY=) counts as unset, so an optional setting uses its default.
# Fill in every required setting: the data worker and processor stop with a
# message naming a missing one.
# === README ===

# Config

## Public URL
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

## Database (not used in docker-compose)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

## BetterAuth
BETTER_AUTH_SECRET=replace-with-secret
BETTER_AUTH_URL=http://localhost:3000

## osu! API v2 credentials and rate limits
DATA_WORKER_OSU_CLIENT_ID=replace-with-worker-client-id
DATA_WORKER_OSU_CLIENT_SECRET=replace-with-worker-client-secret
WEB_OSU_CLIENT_ID=replace-with-web-client-id
WEB_OSU_CLIENT_SECRET=replace-with-web-client-secret

## osu! / osu!track rate limits
OSU_API_RATE_LIMIT_REQUESTS=60
OSU_API_RATE_LIMIT_WINDOW_SECONDS=60
OSUTRACK_API_RATE_LIMIT_REQUESTS=60
OSUTRACK_API_RATE_LIMIT_WINDOW_SECONDS=60

## Auto refetching (true in production)
## PLAYER_OSU_REFETCH_OUTDATED_DAYS is the fallback cadence for rated players outside the rank tiers
## PLAYER_OSU_REFETCH_UNRATED_DAYS is the cadence for players with no rating (30 when unset)
PLAYER_OSU_AUTO_REFETCH_ENABLED=false
PLAYER_OSU_REFETCH_INTERVAL_MINUTES=30
PLAYER_OSU_REFETCH_OUTDATED_DAYS=14
PLAYER_OSU_REFETCH_UNRATED_DAYS=30

PLAYER_OSUTRACK_AUTO_REFETCH_ENABLED=false
PLAYER_OSUTRACK_REFETCH_INTERVAL_MINUTES=30
PLAYER_OSUTRACK_REFETCH_OUTDATED_DAYS=60

## Beatmap files
## The data worker stores each fetched beatmap's .osu file and calculates its
## difficulty attributes. Off when neither a bucket nor a directory is set.
## Set a Google Cloud Storage bucket or a local directory, not both.
## The key is a GCS HMAC key (access ID + secret) for a service account that
## can overwrite objects in the bucket, such as roles/storage.objectUser.
# BEATMAP_FILES_BUCKET=
# BEATMAP_FILES_ACCESS_KEY_ID=
# BEATMAP_FILES_SECRET_ACCESS_KEY=
# BEATMAP_FILES_DIR=

## Maintenance window
## Weekly data freeze (Tuesdays 11:45-12:15 UTC) that blocks admin writes and
## pauses osu!/osu!track fetches so public archives stay consistent with the
## Tuesday 12:00 UTC processor run. Left false locally so developers aren't
## blocked; set to true in production.
MAINTENANCE_WINDOW_ENABLED=false

## /rpc rate limits
## Per-IP and per-user limits on the site's internal API: enforce refuses calls
## over a limit, observe only logs and counts them, off skips them. When unset,
## production builds enforce them (production and PR previews, which run the
## published image) and `next dev` leaves them off.
# RPC_RATE_LIMIT=observe

## Processor
## The processor reads DATABASE_URL above, falling back to CONNECTION_STRING,
## which otr-replay passes. It queues stats jobs in the database.
RUST_LOG=info

# === CI ===

## Always leave this as false unless running e2e tests. Test sign-in also
## needs BETTER_AUTH_URL on localhost, 127.0.0.1, or the tailnet (*.ts.net).
E2E_TEST_AUTH=false

# === Docker Configuration ===

## Database
DOCKER_DATABASE_URL=postgresql://postgres:password@db:5432/postgres
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=password
DOCKER_POSTGRES_DB=postgres

## Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password
# Also the password of otr_grafana_read_only, the database role Grafana reads
# production through. The migrate step sets it.
GRAFANA_SECRET_KEY=secret
DISCORD_WEBHOOK_URL=
METRICS_PORT=9091
# Prometheus sends this to read the web app's metrics, which the web app
# refuses to everyone while it is blank.
METRICS_AUTH_TOKEN=secret

## Tracing
# Tracing is off until an OTLP endpoint is set. Docker sets this for the web and
# data-worker containers; uncomment to export from a locally running app into
# the compose stack's collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

## Port overrides
# Defaults --> (web 3000 / grafana 3001 / web standby 3002).
# WEB_PORT=3020
# GRAFANA_PORT=3021
# WEB_STANDBY_PORT=3022